# DeepSeek AI 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat

# 百炼 LLM（OpenAI 兼容协议，复用百炼 IMAGE_API_KEY / TTS_API_KEY）
# 默认 base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
# 可用模型：qwen3.7-flash-2026-07-15（推荐，输入0.2/输出0.8元每百万token）
#            deepseek-v4-flash（旧版价，输入1/输出2元每百万token）
# 已在设置页中提供可视化切换，无需手动配置以下变量
# BAILIAN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 阿里云百炼 TTS 配置
# 默认模型: cosyvoice-v3-flash，默认音色: loongandy_v3 (美式英文男)
TTS_API_KEY=your_bailian_api_key_here
TTS_VOICE=loongandy_v3
# TTS_MODEL=cosyvoice-v3-flash
#
# 可选模型（应用内可直接切换，推荐最佳英文发音模型）：
#
# 1. qwen-audio-3.0-tts-plus  ← 最佳音质，48kHz，支持指令控制
#    推荐英文音色: loongmary (温暖英音·女), loongeva_v3.6 (高智美音·女), loongjohn (沉稳亲切美音·男)
#
# 2. cosyvoice-v3-plus        ← 高清音质，音色最丰富
#    推荐英文音色: loongandy_v3 (美式英文男), loongbeth_v3 (美式英文女), loongemily_v3 (英式英文女), loongeric_v3 (英式英文男)
#
# 3. cosyvoice-v3-flash       ← 快速合成，性价比高，支持指令控制
#    推荐英文音色: 同上 (与 v3-plus 共用音色库)
#
# ⚠ 注意: 模型和音色不能混用！
#   - Qwen-Audio-TTS 模型只能用 loongmary / loongeva_v3.6 / loongjohn 等专用音色
#   - CosyVoice 模型只能用 loongandy_v3 / loongbeth_v3 等 cosyvoice 系列音色

# 阿里云百炼 文生图配置（复用 TTS_API_KEY）
# 默认模型: wan2.7-image（万相档，角色一致性多图生成，适合连环画）
# IMAGE_API_KEY 留空时默认复用 TTS_API_KEY
# IMAGE_API_KEY=your_bailian_image_api_key_here
# IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_MODEL=wan2.7-image
#
# 可选模型（应用内可直接切换，多档阶梯，价格依据《阿里云百炼图像生成价格文档》）：
#
# ① 旗舰档：
#    qwen-image-3.0-pro  1k 0.25元/张，文字渲染最强（同步端点，10张免费）
#    qwen-image-2.0-pro-2026-06-22  0.5元/张（同步端点，限时免费100张）
# ② 高清档（0.18元/张 2k）：
#    qwen-image-3.0（同步端点，10张免费）
# ③ 性价比档（0.10元/张）：
#    z-image-turbo（关提示词改写 prompt_extend=false，同步端点）
# ④ 万相·连环画档（0.20元/张）：
#    wan2.7-image（默认，异步端点，角色一致）
# ⑤ 免费档（TokenRhythm 平台，见下方 TOKENRHYTHM_API_KEY）
#
# 模型选择建议：
#   - 连环画多画面生成（需人物一致）：wan2.7-image（万相档）
#   - 单张高质量配图/含文字海报：qwen-image-3.0-pro（旗舰档）
#   - 批量快速生成/成本敏感：z-image-turbo（性价比档）
#   - 零成本试用：qwen-image-2.0 / wan2.7-image（TokenRhythm 免费档）

# TokenRhythm 文生图（OpenAI 兼容协议，免费调用 qwen-image-2.0 / wan2.7-image）
# 文档：https://tokenrhythm.studio/docs/api-integration
# 鉴权：请求头 Authorization: Bearer sk_xxx
# 留空则前端选择"免费"档模型时会提示未配置 TOKENRHYTHM_API_KEY
# TOKENRHYTHM_API_KEY=sk_your_tokenrhythm_api_key_here
# TOKENRHYTHM_BASE_URL=https://tokenrhythm.studio/v1
#
# 可选免费模型（应用内可直接选择，走 OpenAI /v1/images/generations 端点）：
#
# 1. qwen-image-2.0       ← 免费，千问图像2.0，文生图最高 2048x2048
# 2. wan2.7-image-free    ← 免费，万相2.7，角色一致，适合连环画
#    （实际下发模型名为 wan2.7-image，value 加 -free 后缀以区分百炼付费档）

# ========================================================================
# 用户系统（认证 + 每用户分库 + 每日配额）
# ========================================================================
# 会话签名密钥（必配，生产环境用随机长串，如 `python -c "import secrets;print(secrets.token_hex(32))"`）
# AUTH_SECRET=please-change-me-to-a-long-random-string

# 开发者账号（沿用原 Nginx Basic Auth 账号密码迁移到 .env，不落明文文档）
# DEV_USERNAME=wordisle
# DEV_PASSWORD=your_dev_password

# 管理员固定账号：逗号分隔 username:password（可多个）
# ADMIN_USERS=admin1:pass1,admin2:pass2

# 本地开发/回归测试可整体关闭认证（中间件放行、/api/me 返回默认开发者身份）
# AUTH_DISABLED=1

# 首次启动是否把旧全局 words.db 迁移为开发者库（回归测试置 0 关闭）
# MIGRATE_LEGACY_DB=1

# ========================================================================
# MCP Server（可选：把词屿能力通过 Model Context Protocol 暴露给外部 AI，
# 见 mvp/mcp_server.py。不配置则默认按下方值运行）
# ========================================================================
# 服务固定以某用户 uid 身份读库（默认开发者词库 dev-wordisle.db）
# WORDISLE_MCP_USER=wordisle
# 是否暴露写操作（add_words/delete_word）。安全铁律：默认关闭，外部 AI 不经确认直接改词库
# WORDISLE_MCP_ENABLE_WRITE=0

