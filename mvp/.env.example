# DeepSeek AI 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat

# 阿里云百炼 TTS 配置
# 默认模型: cosyvoice-v3-flash，默认音色: loongandy_v3 (美式英文男)
TTS_API_KEY=your_bailian_api_key_here
TTS_VOICE=loongandy_v3
# TTS_MODEL=cosyvoice-v3-flash
#
# 可选模型（应用内可直接切换，推荐最佳英文发音模型）：
#
# 1. qwen-audio-3.0-tts-plus  ← 最佳音质，48kHz，支持指令控制
#    推荐英文音色: loongmary (温暖英音·女), loongeva_v3.6 (高智美音·女), loongjohn (沉稳亲切美音·男)
#
# 2. cosyvoice-v3-plus        ← 高清音质，音色最丰富
#    推荐英文音色: loongandy_v3 (美式英文男), loongbeth_v3 (美式英文女), loongemily_v3 (英式英文女), loongeric_v3 (英式英文男)
#
# 3. cosyvoice-v3-flash       ← 快速合成，性价比高，支持指令控制
#    推荐英文音色: 同上 (与 v3-plus 共用音色库)
#
# ⚠ 注意: 模型和音色不能混用！
#   - Qwen-Audio-TTS 模型只能用 loongmary / loongeva_v3.6 / loongjohn 等专用音色
#   - CosyVoice 模型只能用 loongandy_v3 / loongbeth_v3 等 cosyvoice 系列音色

# 阿里云百炼 文生图配置（复用 TTS_API_KEY）
# 默认模型: wan2.7-image（均衡档，角色一致性多图生成，适合连环画）
# IMAGE_API_KEY 留空时默认复用 TTS_API_KEY
# IMAGE_API_KEY=your_bailian_image_api_key_here
# IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_MODEL=wan2.7-image
#
# 可选模型（应用内可直接切换，三档配置）：
#
# 1. qwen-image-3.0-pro  ← 旗舰档，0.50元/张
#    千问3.0旗舰版，支持agent prompt智能改写，擅长中英文文本渲染；复杂版面首选
#    调用方式：同步（multimodal-generation/generation）
#
# 2. wan2.7-image        ← 均衡档，0.20元/张，50张免费额度
#    角色一致性多图生成，连环画人物统一；2K分辨率
#    调用方式：异步轮询（text2image/image-synthesis）
#
# 3. z-image-turbo       ← 性价比档，约0.04元/张
#    快速低成本，速度比wan2.7快10倍；写实人像和产品照片；仅文生图不支持编辑
#    调用方式：同步（multimodal-generation/generation）
#
# 模型选择建议（依据《文生图文档.txt》）：
#   - 连环画多画面生成（需人物一致）：wan2.7-image（均衡档）
#   - 单张高质量配图/含文字海报：qwen-image-3.0-pro（旗舰档）
#   - 批量快速生成/成本敏感：z-image-turbo（性价比档）

# 每日限制（可选）
DAILY_AI_LIMIT=20
DAILY_TTS_LIMIT=50
DAILY_IMAGE_LIMIT=50
