# WordIsle 生产环境变量模板（复制为 mvp/.env 后逐项填写）
# 生成随机串：python -c "import secrets;print(secrets.token_hex(32))"

# ============ 必填：会话与开发者账号 ============
AUTH_SECRET=请替换为-64位随机串
DEV_USERNAME=wordisle
DEV_PASSWORD=请替换为-20位以上随机口令
# 管理员：逗号分隔 username:password（可多个）
ADMIN_USERS=admin1:请替换为强口令

# 上 HTTPS 后必须为 1（Cookie 只走加密连接）
COOKIE_SECURE=1

# ============ 必填：模型通道 ============
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat

# 百炼（LLM + 文生图 + TTS 共用，IMAGE_API_KEY 留空时复用 TTS_API_KEY）
TTS_API_KEY=
IMAGE_API_KEY=
IMAGE_MODEL=qwen-image-2.1-turbo
BAILIAN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# TokenRhythm（可选，当前档位未使用）
TOKENRHYTHM_API_KEY=
TOKENRHYTHM_BASE_URL=https://tokenrhythm.studio/v1

# ============ 必填：短信（不配则注册/找回自动隐藏，仅游客可用） ============
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ============ 成本与防刷 ============
VIDEO_ENABLED=0
DAILY_IMAGE_LIMIT=300
GUEST_DAILY_PER_IP=30
GUEST_DAILY_TOTAL=500
RATE_LIMIT_PER_MINUTE=1200
RATE_LIMIT_CAPTCHA_PER_MINUTE=20
MAX_WORDS_PER_IMPORT=200
MAX_EXTRACT_TEXT_CHARS=20000
MAX_ASSISTANT_MESSAGE_CHARS=4000
MAX_PREFETCH_AUDIO=10

# 有域名后填：https://你的域名（逗号分隔多个）
CORS_ORIGINS=

# ============ 运维（可选） ============
SERVERCHAN_SENDKEY=
MIGRATE_LEGACY_DB=1
